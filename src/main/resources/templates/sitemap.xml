<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:th="http://www.thymeleaf.org">

    <url>
        <loc th:text="${baseUrl} + '/'">https://lutorlms.com/</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>

    <url>
        <loc th:text="${baseUrl} + '/courses'">https://lutorlms.com/courses</loc>
        <changefreq>daily</changefreq>
        <priority>0.9</priority>
    </url>

    <url th:each="course : ${courses}">
        <loc th:text="${baseUrl} + '/courses/' + ${course.id}">https://lutorlms.com/courses/1</loc>
        <lastmod th:text="${#temporals.format(course.updatedAt, 'yyyy-MM-dd')}">2026-06-24</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>

</urlset>
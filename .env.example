# Copy this file to `.env` and edit values. `.env` is gitignored.
# docker compose automatically picks up `.env` from the project root.

# ── Docker Hub image coordinates ────────────────────────────
DOCKERHUB_USER=gtnobrand
APP_TAG=latest

# ── Host port mapping ───────────────────────────────────────
APP_PORT=8080

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=lutorlms
POSTGRES_USER=lutorlms
POSTGRES_PASSWORD=change-me

# ── Schema management ───────────────────────────────────────
# Flyway owns the schema; Hibernate runs in `validate` mode. Leave as-is.
DDL_AUTO=validate

# ── App secrets (REQUIRED for production) ───────────────────
# Generate a base64 256-bit key, e.g.:  openssl rand -base64 32
# If left blank, the app boots with an ephemeral key (tokens reset on every restart).
JWT_SECRET=
ADMIN_EMAIL=admin@lutorlms.local
ADMIN_PASSWORD=change-me

# ── Optional: PayPal (leave blank to disable payment endpoints) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Optional: Google OAuth login ────────────────────────────
# Set both, then uncomment the two SPRING_SECURITY_... lines in docker-compose.yml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JVM tuning ──────────────────────────────────────────────
JAVA_OPTS=-Xms256m -Xmx768m

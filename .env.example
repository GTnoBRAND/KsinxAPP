# Copy this file to `.env` and edit values. `.env` is gitignored.
# docker compose automatically picks up `.env` from the project root.

# ── Docker Hub image coordinates ────────────────────────────
DOCKERHUB_USER=gtnobrand
APP_TAG=latest

# ── Host port mapping ───────────────────────────────────────
APP_PORT=8080

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=lutorlms
POSTGRES_USER=lutorlms
POSTGRES_PASSWORD=change-me

# ── Schema management ───────────────────────────────────────
# Flyway owns the schema; Hibernate runs in `validate` mode. Leave as-is.
DDL_AUTO=validate

# ── App secrets (REQUIRED for production) ───────────────────
# Generate a base64 256-bit key, e.g.:  openssl rand -base64 32
# If left blank, the app boots with an ephemeral key (tokens reset on every restart).
JWT_SECRET=
ADMIN_EMAIL=admin@lutorlms.local
ADMIN_PASSWORD=change-me

# ── MinIO object storage ────────────────────────────────────
# Root credentials seed the MinIO server itself; the same values are also passed
# to the Spring app as MINIO_ACCESS_KEY / MINIO_SECRET_KEY (see docker-compose.yml).
MINIO_ROOT_USER=lutorlms
MINIO_ROOT_PASSWORD=lutorlms-minio-secret
# Browser-facing URL used in presigned download links. Locally this matches the
# host port (9000); in production point it at your public MinIO/CDN hostname.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_PUBLIC=lutorlms-public
MINIO_BUCKET_PRIVATE=lutorlms-private

# ── SMTP / email (REQUIRED for the registration verification email) ──
# Default host/port target Gmail. For Gmail:
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#      (16 chars, no spaces). Use that as MAIL_PASSWORD — NOT your account password.
#   3. MAIL_USERNAME is the full Gmail address; MAIL_FROM normally matches it
#      (Gmail rewrites the From: header to the authenticated address anyway).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=LutorLMS
# Base URL used inside verification links emailed to users. For local dev use
# http://localhost:8080; in production set this to your public app URL.
APP_BASE_URL=http://localhost:8080

# ── Optional: PayPal (leave blank to disable payment endpoints) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Optional: Google OAuth login ────────────────────────────
# Set both, then uncomment the two SPRING_SECURITY_... lines in docker-compose.yml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JVM tuning ──────────────────────────────────────────────
JAVA_OPTS=-Xms256m -Xmx768m

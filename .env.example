# Copy this file to `.env` and edit values. `.env` is gitignored.
# docker compose automatically picks up `.env` from the project root.

# ── Docker Hub image coordinates ────────────────────────────
DOCKERHUB_USER=gtnobrand
APP_TAG=latest

# ── Host port mapping ───────────────────────────────────────
APP_PORT=8080

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=lutorlms
POSTGRES_USER=lutorlms
POSTGRES_PASSWORD=change-me

# ── Schema management ───────────────────────────────────────
# `update` creates/updates tables on first boot; switch to `validate`
# once the schema is stable in your environment.
DDL_AUTO=update

# ── App secrets (override the defaults baked in the image) ──
JWT_SECRET=replace-with-a-base64-32-byte-secret
ADMIN_EMAIL=admin@lms.com
ADMIN_PASSWORD=change-me

# ── Optional integrations (leave blank to use baked defaults)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── JVM tuning ──────────────────────────────────────────────
JAVA_OPTS=-Xms256m -Xmx768m
